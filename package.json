{
  "name": "commerceflow",
  "version": "1.0.0",
  "description": "CommerceFlow e-commerce backend built with Node.js, Express, and PostgreSQL",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node scripts/database/migrate.js",
    "db:seed": "node scripts/database/seed-catalog.js",
    "worker": "node src/jobs/worker.js",
    "demo:webhook": "node scripts/development/send-payment-webhook.js",
    "bench:api": "node scripts/benchmarks/api-benchmark.js",
    "lab:event-loop": "node scripts/labs/01-event-loop.js",
    "lab:worker": "node scripts/labs/02-worker-lab.js",
    "lab:cluster": "node scripts/labs/03-cluster.js",
    "lab:memory": "node --expose-gc scripts/labs/04-memory.js",
    "lab:child": "node scripts/labs/05-child-process.js",
    "lab:circuit": "node scripts/labs/06-circuit-breaker.js"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "bullmq": "^6.7.7",
    "compression": "^1.8.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "zod": "^4.6.7"
  }
}
